{
  "name": "shanshui-quote-search",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "sync": "node scripts/sync-kdocs.mjs && node scripts/build-catalog.mjs",
    "sync:images": "node scripts/build-catalog.mjs && node scripts/sync-product-images.mjs && node scripts/build-catalog.mjs",
    "protect": "node scripts/encrypt-catalog.mjs",
    "deploy:pages": "zsh scripts/deploy-pages.sh",
    "deploy:edgeone": "zsh scripts/deploy-edgeone.sh",
    "reauth:wps": "node scripts/export-wps-session.mjs && zsh scripts/publish-wps-session.sh"
  },
  "dependencies": {
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "edgeone": "^1.6.47",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
